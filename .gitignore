# Este .gitignore está basado en la plantilla oficial de Unity:
# https://github.com/github/gitignore/blob/main/Unity.gitignore

# Carpetas generadas por Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Archivos de assets generados automáticamente
[Aa]ssets/AssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# Archivos de paquetes generados
[Pp]ackages/*/.tmp/

# Archivos generados por Visual Studio / VSCode / Rider / MonoDevelop
.vs/
.vsconfig
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Archivos de caché específicos de Unity
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Archivos de captura de rendimiento de Unity
[Cc]rashlytics[Bb]uild.properties

# Archivos generados por plugins Unity
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
